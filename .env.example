# Postgres
POSTGRES_USER=mhpt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mhpt
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mhpt:change-me@postgres:5432/mhpt

# Backend
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=replace-with-a-long-random-string
# In production behind Docker secrets, set JWT_SECRET_FILE=/run/secrets/jwt_secret instead of
# JWT_SECRET directly (same pattern for GOOGLE_CLIENT_SECRET_FILE / DATABASE_URL_FILE) — see
# docker-compose.prod.yml.

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
