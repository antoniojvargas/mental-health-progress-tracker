# Variables no sensibles para docker-compose.prod.yml — copia a `.env.production` y ajusta.
# Los valores sensibles (contraseñas, JWT_SECRET, client secret de Google) van en secrets/,
# nunca aquí. Ver secrets/README.md.

POSTGRES_USER=mhpt
POSTGRES_DB=mhpt

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/auth/google/callback

FRONTEND_URL=https://tu-dominio.com
LOG_LEVEL=info

# Puerto público del frontend (nginx) en el host
HTTP_PORT=80
