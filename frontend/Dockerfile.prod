# Build context is the repo root (not ./frontend) — same reason as backend/Dockerfile.prod:
# `tsc -b` (run by `npm run build`) needs to see ../shared to type-check the shared import.

FROM node:22-alpine AS build
WORKDIR /repo
COPY shared ./shared
COPY frontend ./frontend
WORKDIR /repo/frontend
RUN npm ci
RUN npm run build

FROM nginx:alpine AS runtime
COPY --from=build /repo/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# nginx:alpine already ships an unprivileged `nginx` user (uid 101) — it just isn't used by
# default. Binding port 80 needs CAP_NET_BIND_SERVICE, so the runtime listens on 8080 instead
# (see nginx.conf) and the compose port mapping does the 80->8080 translation on the host side.
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://localhost:8080/ || exit 1
